[Unit]
Description=LLM Monitor 2X-DGX-Spark
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llm-monitor
WorkingDirectory=/opt/llm-monitor-2x-dgx-spark/backend
Environment=PYTHONUNBUFFERED=1
Environment=DGX_MONITOR_DB=/var/lib/llm-monitor-2x-dgx-spark/monitor.sqlite3
EnvironmentFile=-/etc/llm-monitor-2x-dgx-spark.env
ExecStart=/opt/llm-monitor-2x-dgx-spark/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 18080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
