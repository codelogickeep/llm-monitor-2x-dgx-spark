# Live layout of /etc/dgx-spark-monitor.env on the Raspberry Pi deployment
# (two DGX Sparks behind the be2c HTTP bridge), pinned to the Vision-Exp lane.
#
# It complements config.example.env: that file documents every knob with
# placeholders, this one records the addresses actually in use.
DGX_MONITOR_SSH_USER=zhengyd01
DGX_MONITOR_NODE_1_ID=be2c
DGX_MONITOR_NODE_1_NAME=spark-be2c
DGX_MONITOR_NODE_1_HOST=spark-be2c.local
DGX_MONITOR_NODE_1_IFACES=enp1s0f1np1,enP2p1s0f1np1,wlP9s9
DGX_MONITOR_NODE_1_ROCE_IFACES=enp1s0f1np1,enP2p1s0f1np1
DGX_MONITOR_NODE_2_ID=aa43
DGX_MONITOR_NODE_2_NAME=spark-aa43
DGX_MONITOR_NODE_2_HOST=spark-aa43.local
DGX_MONITOR_NODE_2_IFACES=enp1s0f0np0,enP2p1s0f0np0,wlP9s9
DGX_MONITOR_NODE_2_ROCE_IFACES=enp1s0f0np0,enP2p1s0f0np0
DGX_MONITOR_VLLM_METRICS_URL=http://spark-be2c.local:18889/metrics
DGX_MONITOR_VLLM_MODELS_URL=http://spark-be2c.local:18889/v1/models

DGX_MONITOR_DEPLOYMENT_ID=deepseek-v4-flash-vision-exp-prod-20260921
