# Deployed unit on the Raspberry Pi (zhengyd-pi), captured verbatim from
# /etc/systemd/system/dgx-spark-monitor.service. The generic
# llm-monitor-2x-dgx-spark.service in this directory stays as the upstream
# example; this file plus the drop-ins and the env example reproduce the live
# deployment.
[Unit]
Description=LLM Monitor 2X-DGX-Spark
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zhengyd
WorkingDirectory=/opt/dgx-spark-monitor/backend
Environment=PYTHONUNBUFFERED=1
Environment=DGX_MONITOR_POLL_INTERVAL=2.5
Environment=DGX_MONITOR_DB=/var/lib/dgx-spark-monitor/monitor.sqlite3
Environment=HOME=/home/zhengyd
ExecStart=/usr/bin/python3 -m uvicorn app:app --host 0.0.0.0 --port 18080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
